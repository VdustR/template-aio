{
  "name": "@vdustr/template-aio-ts-lib",
  "version": "2.0.1",
  "description": "A template for developing libraries",
  "license": "MIT",
  "author": {
    "name": "ViPro",
    "email": "vdustr@gmail.com",
    "url": "https://vdustr.github.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VdustR/template-aio.git",
    "directory": "packages/template-ts-lib"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
